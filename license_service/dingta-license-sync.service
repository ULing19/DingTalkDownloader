[Unit]
Description=Sync paid downloader orders from product-allowlisted Xianyu items
After=network-online.target dingta-license.service
Wants=network-online.target

[Service]
Type=oneshot
User=dingta-license
Group=dingta-license
WorkingDirectory=/opt/dingta-license
EnvironmentFile=/etc/dingta-license.env
ExecStart=/opt/dingta-license/venv/bin/python -c "from app import sync_configured_products; print(sync_configured_products())"
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/dingta-license
