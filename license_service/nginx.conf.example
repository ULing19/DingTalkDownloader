# Configure TLS with certificate/key issued for the configured DNS name or IP SAN.
# Never expose Uvicorn port 8765 directly to the public Internet.
limit_req_zone $binary_remote_addr zone=license_api:10m rate=20r/m;

server {
    listen 443 ssl http2;
    server_name LICENSE_HOSTNAME_OR_IP;
    ssl_certificate     /etc/letsencrypt/live/LICENSE_HOSTNAME_OR_IP/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/LICENSE_HOSTNAME_OR_IP/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 16k;

    location / {
        limit_req zone=license_api burst=20 nodelay;
        proxy_pass http://127.0.0.1:8765;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 3s;
        proxy_read_timeout 10s;
        proxy_send_timeout 10s;
    }
}
